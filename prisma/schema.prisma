// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum JobStatus {
  QUOTING
  AWARDED
  ACTIVE
  ON_HOLD
  COMPLETE
  CLOSED
}

enum QuoteStatus {
  DRAFT
  IN_REVIEW
  SENT
  REVISED
  WON
  LOST
  LOST_BC
  EXPIRED
  CANCELLED
}

enum QuoteType {
  STOCK_ONLY
  CONFIGURABLE_STRUCTURES
  CUSTOM_STRUCTURES
  MIXED
}

enum QuoteLineType {
  STOCK_PRODUCT
  CONFIGURABLE_STRUCTURE
  CUSTOM_STRUCTURE
  SERVICE
  MISC
  CATEGORY
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductType {
  STOCK_PRECAST
  CASTING
  ACCESSORY
  PRECAST_PIPE
  ADS_PIPE
  CONFIGURABLE
  SERVICE
}

enum ProductDocumentType {
  GENERIC_SUBMITTAL
  SHOP_DRAWING
  CUT_SHEET_TEMPLATE
  SPEC_SHEET
  INSTALLATION_INSTRUCTIONS
  OTHER
}

enum DrainRingStyle {
  DRAIN
  SANITARY
  SOLID
}

enum CastingSupplierOrigin {
  DOMESTIC
  IMPORTED
}

enum CastingSupplierStatus {
  ACTIVE
  INACTIVE
}

enum CastingRole {
  ASSEMBLY
  COMPONENT
}

enum CastingPieceRole {
  FRAME
  COVER_GRATE
  HOOD
}

enum ProductKind {
  STANDARD
  DRAIN_RING
  CASTING_ASSEMBLY
  CASTING_COMPONENT
}

enum ProductCategoryStatus {
  ACTIVE
  INACTIVE
}

model ProductCategory {
  id                 String                @id @default(cuid())
  name               String                @unique
  productType        ProductType
  sortOrder          Int                   @default(0)
  status             ProductCategoryStatus @default(ACTIVE)
  defaultProductKind ProductKind?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  subcategories ProductSubcategory[]
  products      Product[]

  @@index([status])
  @@index([sortOrder])
  @@index([productType])
}

model ProductSubcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([categoryId, name])
  @@index([categoryId])
}

model CastingSupplier {
  id        String                @id @default(cuid())
  name      String                @unique
  origin    CastingSupplierOrigin
  sortOrder Int                   @default(0)
  status    CastingSupplierStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  products         Product[]
  purchaseReceipts PurchaseReceiptEntry[]

  @@index([status])
  @@index([sortOrder])
}

model Product {
  id                   String        @id @default(cuid())
  productCode          String        @unique
  name                 String
  productType          ProductType   @default(STOCK_PRECAST)
  categoryId           String
  subcategoryId        String?
  description          String?
  unit                 String        @default("EA")
  cost                 Decimal?      @db.Decimal(12, 2)
  weight               Decimal?      @db.Decimal(12, 2)
  yards                Decimal?      @db.Decimal(12, 4)
  taxable              Boolean       @default(true)
  trackInventory       Boolean       @default(true)
  currentStockQuantity Int           @default(0)
  reorderLevel         Int           @default(0)
  yardLocation         String?
  status               ProductStatus @default(ACTIVE)
  notes                String?
  productKind               ProductKind      @default(STANDARD)
  isDrainRing          Boolean         @default(false)
  heightFeet           Decimal?        @db.Decimal(6, 2)
  ringDiameterFeet     Decimal?        @db.Decimal(6, 2)
  drainRingStyle       DrainRingStyle  @default(DRAIN)
  isCasting                 Boolean          @default(false)
  castingRole               CastingRole?
  castingPieceRole          CastingPieceRole?
  castingSupplierId         String?
  manufacturerCode          String?
  castingSoldAsUnit         Boolean          @default(false)
  pipeDiameterInches        Decimal?         @db.Decimal(6, 2)
  pipeLengthFeet            Decimal?         @db.Decimal(6, 2)
  pipeClass                 String?
  pipeJointType             String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime      @updatedAt

  documents               ProductDocument[]
  jobStructures           JobStructure[]
  castingUsages           JobStructureCasting[] @relation("CastingProduct")
  quoteLineItems          QuoteLineItem[]
  deliveryTicketLineItems DeliveryTicketLineItem[]
  inventoryTransactions   InventoryTransaction[]
  productionLines         DailyProductionLine[]
  purchaseReceiptLines    PurchaseReceiptLine[]
  purchaseOrderLines      PurchaseOrderLine[]
  priceListItems          PriceListItem[]
  invoiceLineItems        InvoiceLineItem[]
  castingSupplier         CastingSupplier?              @relation(fields: [castingSupplierId], references: [id], onDelete: SetNull)
  castingAssemblyComponents ProductCastingComponent[]   @relation("CastingAssembly")
  castingComponentOf        ProductCastingComponent[]   @relation("CastingComponent")
  structureTemplates        StructureTemplate[]         @relation("TemplateCasting")
  productCategory           ProductCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory               ProductSubcategory?         @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([productKind])
  @@index([castingSoldAsUnit])
  @@index([isDrainRing, ringDiameterFeet, drainRingStyle])
  @@index([isCasting])
  @@index([castingRole])
  @@index([castingSupplierId])
  @@index([manufacturerCode])
  @@index([productKind, pipeDiameterInches])
  // Trigram indexes back the products list's ILIKE %term% search; without
  // them every keystroke search is a sequential scan.
  @@index([productCode(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_productCode_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_description_trgm_idx")
}

/// BOM link: full casting assembly → frame/cover/grate component SKUs.
model ProductCastingComponent {
  id          String           @id @default(cuid())
  assemblyId  String
  componentId String
  pieceRole   CastingPieceRole
  quantity    Int              @default(1)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  assembly  Product @relation("CastingAssembly", fields: [assemblyId], references: [id], onDelete: Cascade)
  component Product @relation("CastingComponent", fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([assemblyId, pieceRole])
  @@unique([assemblyId, componentId])
  @@index([assemblyId])
  @@index([componentId])
}

model ProductDocument {
  id           String              @id @default(cuid())
  productId    String
  documentType ProductDocumentType
  documentName String
  filePath     String
  fileSize     Int?
  mimeType     String?
  notes        String?
  uploadedAt   DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Customer {
  id        String         @id @default(cuid())
  name      String
  /// Short name for filenames and shorthand (e.g. sent-quote PDF names).
  nickname  String?
  status    CustomerStatus @default(ACTIVE)
  /// Company main line; person-level phones live on contacts.
  phone     String?
  address   String?
  town      String?
  state     String?
  zip       String?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  contacts            Contact[]
  contactRoleDefaults CustomerContactRoleDefault[]
  jobs                Job[]
  jobBidders          JobBidder[]
  quotes              Quote[]
  deliveryTickets     DeliveryTicket[]
  invoices            Invoice[]

  // btree for the list's default name sort and status filter; trigram
  // index backs the ILIKE %term% name search (person-level search moved
  // to the Contact trigram indexes).
  @@index([name])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Customer_name_trgm_idx")
}

/// What a contact handles for the customer; drives role-based defaults
/// (quotes -> ESTIMATING, invoices -> BILLING, delivery tickets -> FIELD).
enum ContactRole {
  ESTIMATING
  BILLING
  FIELD
}

model Contact {
  id         String        @id @default(cuid())
  customerId String
  name       String
  title      String?
  phone      String?
  email      String?
  /// General fallback contact (UI "Main") when no role default applies.
  isPrimary  Boolean       @default(false)
  roles      ContactRole[] @default([])
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  customer     Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotes       Quote[]
  roleDefaults CustomerContactRoleDefault[]

  @@index([customerId])
  // Trigram indexes back the customer directory's person search now that
  // the mirrored header columns are gone.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Contact_email_trgm_idx")
}

/// One default contact per role per customer (DB-enforced via the unique).
model CustomerContactRoleDefault {
  id         String      @id @default(cuid())
  customerId String
  role       ContactRole
  contactId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([customerId, role])
  @@index([contactId])
}

model Job {
  id             String     @id @default(cuid())
  jobNumber      String     @unique
  year           Int
  yearTwoDigit   Int
  sequenceNumber Int
  customerId     String?
  customerName   String
  projectName    String
  projectAddress String?
  city           String?
  state          String?
  zip            String?
  status         JobStatus  @default(QUOTING)
  bidDate        DateTime?
  awardedDate    DateTime?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  folderPath     String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  files           JobFile[]
  bidders         JobBidder[]
  quotes          Quote[]
  jobStructures   JobStructure[]
  deliveryTickets DeliveryTicket[]
  invoices        Invoice[]
  favorites       JobFavorite[]
  planSheets      PlanSheet[]

  @@unique([year, sequenceNumber])
  @@index([customerId])
  @@index([year])
  @@index([yearTwoDigit])
  @@index([status])
  // Dashboard "recent activity" sorts by updatedAt; trigram indexes back the
  // jobs list's ILIKE %term% search fields.
  @@index([updatedAt])
  @@index([jobNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_jobNumber_trgm_idx")
  @@index([projectName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_projectName_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_customerName_trgm_idx")
  @@index([projectAddress(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_projectAddress_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_city_trgm_idx")
  @@index([state(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_state_trgm_idx")
  @@index([zip(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_zip_trgm_idx")
}

/// Contractor invited to bid on a job (bid list entry).
model JobBidder {
  id         String   @id @default(cuid())
  jobId      String
  customerId String
  sortOrder  Int      @default(0)
  isWinner   Boolean  @default(false)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quotes   Quote[]

  @@unique([jobId, customerId])
  @@index([jobId])
  @@index([customerId])
}

model JobSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model JobFile {
  id             String   @id @default(cuid())
  jobId          String
  fileName       String
  filePath       String
  folderCategory String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, filePath])
  @@index([jobId])
}

enum StructureShape {
  CIRCULAR
  RECTANGULAR
}

enum SectionRole {
  BASE
  RISER
}

enum StructureTemplateStatus {
  ACTIVE
  INACTIVE
}

enum PipeConnectionType {
  KOR_N_SEAL
  CAST_IN
  GROUTED
  OTHER
}

enum SumpMode {
  DEFAULT
  FIXED
}

/// Plan-view wall of a rectangular structure. Declared in the physical enum
/// order (renamed in place from the original A/B/C/D clockwise layout).
enum RectWall {
  UP
  RIGHT
  DOWN
  LEFT
}

/// Horizontal placement of a rectangular wall opening along its wall.
/// FROM_LEFT / FROM_RIGHT dimension the opening centerline from that inside
/// face; TOUCH_LEFT / TOUCH_RIGHT draw the opening touching that wall end.
enum RectOpeningPlacement {
  CENTERED
  FROM_LEFT
  FROM_RIGHT
  TOUCH_LEFT
  TOUCH_RIGHT
}

/// Reusable structure template configured in the Structures tab.
/// Drives the Drill Sheet Workbook calculations.
model StructureTemplate {
  id                          String                  @id @default(cuid())
  name                        String                  @unique
  agencyStandard              String?
  shape                       StructureShape          @default(CIRCULAR)
  wallThicknessInches         Decimal                 @default(8) @db.Decimal(6, 2)
  baseSlabThicknessInches     Decimal                 @default(8) @db.Decimal(6, 2)
  topSlabThicknessInches      Decimal                 @default(16) @db.Decimal(6, 2)
  castingProductId            String?
  minimumBrickInches          Decimal                 @default(4) @db.Decimal(6, 2)
  connectionType              PipeConnectionType      @default(KOR_N_SEAL)
  sumpMode                    SumpMode                @default(DEFAULT)
  sumpFixedInches             Decimal?                @db.Decimal(6, 2)
  openingToJointMinTopInches    Decimal               @default(4) @db.Decimal(6, 2)
  openingToJointMinBottomInches Decimal               @default(4) @db.Decimal(6, 2)
  /// Rectangular templates: wall price per vertical foot of structure height.
  rectWallPricePerFoot        Decimal?                @db.Decimal(12, 2)
  /// Rectangular templates: minimum billed height in feet (e.g. 4' minimum
  /// wall pricing even when the structure is only 2' tall).
  rectMinPricingHeightFeet    Decimal?                @db.Decimal(6, 2)
  /// Rectangular templates: top slab price, charged only when the sheet has one.
  rectTopSlabPrice            Decimal?                @db.Decimal(12, 2)
  /// Rectangular templates: base slab price, charged only when the sheet has one.
  rectBaseSlabPrice           Decimal?                @db.Decimal(12, 2)
  /// Shared sheet-PDF set used by this rectangular template.
  rectPdfSetId                String?
  status                      StructureTemplateStatus @default(ACTIVE)
  notes                       String?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt

  castingProduct Product? @relation("TemplateCasting", fields: [castingProductId], references: [id], onDelete: SetNull)
  rectPdfSet     RectSheetPdfSet? @relation(fields: [rectPdfSetId], references: [id], onDelete: SetNull)
  diameters      StructureTemplateDiameter[]
  rectSizes      StructureTemplateRectSize[]
  templatePdfs   StructureTemplatePdf[]
  jobStructures  JobStructure[]

  @@index([shape])
  @@index([status])
  @@index([castingProductId])
  @@index([rectPdfSetId])
}

/// Named "Sheet PDF Set" shareable across structure templates of its shape.
/// Rectangular sets hold the four slab-variant PDFs; circular sets hold a
/// single PDF (one sheet covers every riser/key combination) stored with
/// hasTopSlab/hasBaseSlab false. Model keeps its historical "Rect" name to
/// avoid churn across consumers.
model RectSheetPdfSet {
  id        String         @id @default(cuid())
  name      String         @unique
  shape     StructureShape @default(RECTANGULAR)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  files     RectSheetPdfSetFile[]
  templates StructureTemplate[]

  @@index([shape])
}

/// One slab-variant PDF inside a set (top slab x base slab matrix).
model RectSheetPdfSetFile {
  id           String   @id @default(cuid())
  setId        String
  hasTopSlab   Boolean
  hasBaseSlab  Boolean
  filePath     String
  originalName String
  fileSize     Int?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  set RectSheetPdfSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, hasTopSlab, hasBaseSlab])
  @@index([setId])
}

/// Fillable drill sheet PDF for a template variant. Circular templates use
/// the hasRiser x hasKey matrix; rectangular templates use hasTopSlab x
/// hasBaseSlab (with hasRiser/hasKey left false).
model StructureTemplatePdf {
  id           String   @id @default(cuid())
  templateId   String
  hasRiser     Boolean
  hasKey       Boolean
  hasTopSlab   Boolean  @default(false)
  hasBaseSlab  Boolean  @default(false)
  filePath     String
  originalName String
  fileSize     Int?
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, hasRiser, hasKey, hasTopSlab, hasBaseSlab])
  @@index([templateId])
}

/// One offered inside diameter for a structure template.
model StructureTemplateDiameter {
  id                 String   @id @default(cuid())
  templateId         String
  insideDiameterFeet Decimal  @db.Decimal(6, 2)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  template StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, insideDiameterFeet])
  @@index([templateId])
}

/// Preset inside length x width combo for a rectangular structure template.
/// Sheets can also enter free L x W; presets are one-click starting points.
model StructureTemplateRectSize {
  id               String   @id @default(cuid())
  templateId       String
  insideLengthFeet Decimal  @db.Decimal(6, 2)
  insideWidthFeet  Decimal  @db.Decimal(6, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  template StructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, insideLengthFeet, insideWidthFeet])
  @@index([templateId])
}

/// Global pipe opening size catalog: material + size + type + boot/no-boot →
/// hole diameter, pipe wall thickness, boot model, price.
model PipeOpeningSize {
  id                      String   @id @default(cuid())
  pipeMaterial            String
  pipeSizeInches          Decimal  @db.Decimal(6, 2)
  pipeType                String
  hasBoot                 Boolean  @default(true)
  holeDiameterInches      Decimal  @db.Decimal(6, 2)
  /// Pipe wall thickness (inches); pipe OD = size + 2 × wall thickness.
  pipeWallThicknessInches Decimal  @default(0) @db.Decimal(6, 2)
  bootModel               String?
  pricePerBoot            Decimal? @db.Decimal(12, 2)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([pipeMaterial, pipeSizeInches, pipeType, hasBoot])
  @@index([pipeMaterial])
  @@index([pipeSizeInches])
}

/// Rectangular-structure opening catalog: material + pipe size -> block-out
/// opening width x height (inches). Skewed pipes have no formula; the sheet
/// form lets the user override the width manually (height stays the same).
model RectOpeningSize {
  id                  String   @id @default(cuid())
  pipeMaterial        String
  pipeSizeInches      Decimal  @db.Decimal(6, 2)
  openingWidthInches  Decimal  @db.Decimal(6, 2)
  openingHeightInches Decimal  @db.Decimal(6, 2)
  pricePerOpening     Decimal? @db.Decimal(12, 2)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([pipeMaterial, pipeSizeInches])
  @@index([pipeMaterial])
}

/// Global mold registry (Settings → Structure Molds): one row per physical
/// circular mold, keyed by inside diameter. Wall thickness and max pour
/// heights are properties of the mold, not the template.
model StructureDiameterConfig {
  id                 String   @id @default(cuid())
  /// Mold name shown in settings and template pickers (e.g. "8' OD Grease Trap").
  label              String?
  insideDiameterFeet Decimal  @unique @db.Decimal(6, 2)
  /// Mold wall thickness; outside Ø = inside Ø + 2 × wall. Null falls back
  /// to the template's wall thickness (legacy rows).
  wallThicknessInches Decimal? @db.Decimal(6, 2)
  maxBaseHeightFeet  Decimal  @db.Decimal(6, 2)
  maxRiserHeightFeet Decimal  @db.Decimal(6, 2)
  keyHeightFeet      Decimal  @db.Decimal(6, 4)
  wallPricePerFoot   Decimal  @default(0) @db.Decimal(12, 2)
  basePrice          Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum StructureType {
  STOCK_PRODUCT
  CONFIGURABLE_PRODUCT
  CUSTOM_STRUCTURE
}

enum StructureStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  IN_PRODUCTION
  MADE
  SHIPPED
}

enum JobStructureDocumentType {
  CUT_SHEET
  JOB_SPECIFIC_SUBMITTAL
  APPROVED_SUBMITTAL
  PRODUCTION_DRAWING
  FIELD_SKETCH
  OTHER
}

/// Job-specific structure instance derived from a product template or custom design.
model JobStructure {
  id                  String          @id @default(cuid())
  jobId               String?
  quoteId             String?
  productId           String?
  structureTemplateId String?
  structureType   StructureType
  structureNumber String?
  description     String?
  quantity        Decimal?        @db.Decimal(12, 4)
  unit            String?
  weight          Decimal?        @db.Decimal(12, 2)
  yards           Decimal?        @db.Decimal(12, 4)
  status          StructureStatus @default(NOT_SUBMITTED)
  productionDate  DateTime?
  submittedDate   DateTime?
  approvedDate    DateTime?
  madeDate        DateTime?
  shippedDate     DateTime?
  needsCutSheet   Boolean         @default(false)
  needsSubmittal  Boolean         @default(false)
  /// True when approval used the generated submittal or verbal OK instead of a signed return.
  usedGeneratedSubmittalForApproval Boolean @default(false)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  job                    Job?                     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote                  Quote?                   @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  product                Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  structureTemplate      StructureTemplate?       @relation(fields: [structureTemplateId], references: [id], onDelete: SetNull)
  quoteLineItems         QuoteLineItem[]
  deliveryTicketLineItems DeliveryTicketLineItem[]
  openings               JobStructureOpening[]
  castings               JobStructureCasting[]
  sections               JobStructureSection[]
  dimensions             JobStructureDimension?
  calc                   JobStructureCalc?
  documents              JobStructureDocument[]
  pieces                 JobStructurePiece[]

  @@index([jobId])
  @@index([quoteId])
  @@index([productId])
  @@index([structureTemplateId])
  @@index([status])
}

/// Named shipping piece of a structure that leaves the yard in parts (e.g. a
/// wet well's base, risers, and top slab). Defined at shipping time; each
/// piece is claimed by at most one delivery ticket line.
model JobStructurePiece {
  id             String   @id @default(cuid())
  jobStructureId String
  name           String
  sortOrder      Int      @default(0)
  weightLbs      Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobStructure            JobStructure             @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)
  deliveryTicketLineItems DeliveryTicketLineItem[]

  @@index([jobStructureId])
}

/// Base/riser breakdown of a configured drill-sheet structure's precast wall.
model JobStructureSection {
  id             String      @id @default(cuid())
  jobStructureId String
  role           SectionRole
  heightFeet     Decimal     @db.Decimal(6, 4)
  label          String?
  sortOrder      Int         @default(0)
  /// Computed pick weight of this section in pounds (150 lb/cf; includes the
  /// base slab when it is cast attached to the bottom section).
  pickWeightLbs  Decimal?    @db.Decimal(12, 2)
  /// Keyed joint at the bottom of this section (both mating faces must match).
  hasBottomKey   Boolean     @default(true)
  /// Keyed joint at the top of this section (both mating faces must match).
  hasTopKey      Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  jobStructure JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)

  @@index([jobStructureId])
}

model JobStructureOpening {
  id                           String              @id @default(cuid())
  jobStructureId               String
  openingNumber                Int?
  label                        String?
  invertElevation              Decimal?            @db.Decimal(12, 4)
  pipeSizeInches               Decimal?            @db.Decimal(6, 2)
  pipeMaterial                 String?
  pipeType                     String?
  angle                        Decimal?            @db.Decimal(12, 4)
  connectionType               PipeConnectionType?
  holeDiameterInches           Decimal?            @db.Decimal(6, 2)
  /// Rectangular structures: which plan wall this opening penetrates.
  wall                         RectWall?
  /// Rectangular structures: placement along the wall (defaults to centered).
  horizontalPlacement          RectOpeningPlacement?
  /// Opening centerline offset from the referenced inside face (inches),
  /// used with FROM_LEFT / FROM_RIGHT placement.
  offsetInches                 Decimal?            @db.Decimal(8, 2)
  /// Rectangular block-out size; width is manually widened for skewed pipes.
  openingWidthInches           Decimal?            @db.Decimal(6, 2)
  openingHeightInches          Decimal?            @db.Decimal(6, 2)
  bootModel                    String?
  topOfPipeFeet                Decimal?            @db.Decimal(12, 4)
  bottomOfOpeningFeet          Decimal?            @db.Decimal(12, 4)
  topOfOpeningFeet             Decimal?            @db.Decimal(12, 4)
  baseTopToOpeningBottomInches Int?
  pricePerBoot                 Decimal?            @db.Decimal(12, 2)
  notes                        String?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  jobStructure JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)

  @@index([jobStructureId])
}

model JobStructureCasting {
  id                 String   @id @default(cuid())
  jobStructureId     String
  castingProductId   String?
  castingType        String?
  castingDescription String?
  frameSize          String?
  coverType          String?
  grateType          String?
  hatchSize          String?
  loadRating         String?
  boltDown           Boolean?
  vented             Boolean?
  quantity           Decimal? @db.Decimal(12, 4)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  jobStructure   JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)
  castingProduct Product?     @relation("CastingProduct", fields: [castingProductId], references: [id], onDelete: SetNull)

  @@index([jobStructureId])
  @@index([castingProductId])
}

model JobStructureDimension {
  id                String   @id @default(cuid())
  jobStructureId    String   @unique
  insideLength      Decimal? @db.Decimal(12, 4)
  insideWidth       Decimal? @db.Decimal(12, 4)
  insideHeight      Decimal? @db.Decimal(12, 4)
  outsideLength     Decimal? @db.Decimal(12, 4)
  outsideWidth      Decimal? @db.Decimal(12, 4)
  outsideHeight     Decimal? @db.Decimal(12, 4)
  wallThickness     Decimal? @db.Decimal(12, 4)
  topSlabThickness  Decimal? @db.Decimal(12, 4)
  baseSlabThickness Decimal? @db.Decimal(12, 4)
  haunch            Decimal? @db.Decimal(12, 4)
  /// Rectangular sheets: top slab present (omitted when the casting sits
  /// directly on the walls). Top slab is always a separate pick.
  hasTopSlab        Boolean?
  /// Rectangular sheets: base slab present (open-bottom structures omit it).
  hasBaseSlab       Boolean?
  /// Base slab cast monolithically with the bottom wall section (included in
  /// its pick weight); false = separate base piece.
  baseAttached      Boolean?
  /// Top-slab access opening (flush slab; opening touches one inside wall edge).
  topSlabOpeningLengthInches Decimal?  @db.Decimal(6, 2)
  topSlabOpeningWidthInches  Decimal?  @db.Decimal(6, 2)
  /// Wall whose inside edge the top-slab opening touches.
  topSlabOpeningSide         RectWall?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobStructure JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)
}

model JobStructureCalc {
  id                    String    @id @default(cuid())
  jobStructureId        String    @unique
  contractorName        String?
  projectName           String?
  sheetDate             DateTime?
  hasSteps              Boolean   @default(false)
  inspection            String?
  approvedBy            String?
  useBase               String?
  useRiser              String?
  brickAdjustment       String?
  rimElevation          Decimal?  @db.Decimal(12, 4)
  lowestInvertFeet      Decimal?  @db.Decimal(12, 4)
  sumpFeet              Decimal?  @db.Decimal(12, 4)
  castingHeightFeet     Decimal?  @db.Decimal(12, 4)
  topSlabThicknessFeet  Decimal?  @db.Decimal(12, 4)
  wallHeightFeet        Decimal?  @db.Decimal(12, 4)
  brickFeet               Decimal?  @db.Decimal(12, 4)

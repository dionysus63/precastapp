  insideDiameterFeet      Decimal?  @db.Decimal(12, 4)
  /// Rectangular sheets: inside plan dimensions.
  insideLengthFeet        Decimal?  @db.Decimal(12, 4)
  insideWidthFeet         Decimal?  @db.Decimal(12, 4)
  baseSlabThicknessFeet   Decimal?  @db.Decimal(12, 4)
  wallPrice               Decimal?  @db.Decimal(12, 2)
  bootsPrice              Decimal?  @db.Decimal(12, 2)
  totalPrice              Decimal?  @db.Decimal(12, 2)
  errorMessage            String?
  notes                   String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  jobStructure JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)
}

model JobStructureDocument {
  id             String                   @id @default(cuid())
  jobStructureId String
  documentType   JobStructureDocumentType
  documentName   String
  filePath       String
  fileSize       Int?
  mimeType       String?
  uploadedAt     DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

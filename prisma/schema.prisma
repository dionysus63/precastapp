  jobStructure JobStructure @relation(fields: [jobStructureId], references: [id], onDelete: Cascade)

  @@index([jobStructureId])
}

/// Customer quote for precast products, configurable structures, custom structures, and services.
/// Quote numbers follow Q-{job}-{scope?}-{contractor?}-R{n} (e.g. Q-26-001-SITE-BAY-R1); R0 is implicit.
model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique
  revisionNumber     Int         @default(0)
  originalQuoteId    String?
  masterQuoteId      String?
  jobId              String?
  jobBidderId        String?
  customerId         String?
  jobNumber          String?
  customerName       String
  projectName        String
  scopeLabel         String?
  projectAddress     String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  contactId          String?
  contactTitle       String?
  status             QuoteStatus @default(DRAFT)
  quoteType          QuoteType   @default(MIXED)
  estimator          String?
  createdById        String?
  quoteDate          DateTime?
  bidDueDate         DateTime?
  expirationDate     DateTime?
  priceListId        String?
  customerPO         String?
  subtotal           Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal     @default(0) @db.Decimal(12, 2)
  deliveryAmount     Decimal     @default(0) @db.Decimal(12, 2)
  taxableAmount      Decimal     @default(0) @db.Decimal(12, 2)
  taxRate            Decimal     @default(0) @db.Decimal(6, 4)
  salesTax           Decimal     @default(0) @db.Decimal(12, 2)
  total              Decimal     @default(0) @db.Decimal(12, 2)
  totalWeight        Decimal     @default(0) @db.Decimal(12, 2)
  totalYards         Decimal     @default(0) @db.Decimal(12, 4)
  internalNotes      String?
  customerNotes      String?
  termsAndConditions String?
  fob                String?
  leadTime           String?
  deliveryNotes      String?
  sentAt             DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobBidder       JobBidder?       @relation(fields: [jobBidderId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact         Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  priceList       PriceList?       @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  originalQuote   Quote?           @relation("QuoteRevisions", fields: [originalQuoteId], references: [id], onDelete: SetNull)
  revisions       Quote[]          @relation("QuoteRevisions")
  masterQuote     Quote?           @relation("QuoteBidderGroup", fields: [masterQuoteId], references: [id], onDelete: SetNull)
  bidderQuotes    Quote[]          @relation("QuoteBidderGroup")
  lineItems       QuoteLineItem[]
  jobStructures   JobStructure[]
  deliveryTickets DeliveryTicket[]
  invoices        Invoice[]
  planSheets      PlanSheet[]

  @@unique([originalQuoteId, revisionNumber])
  @@index([jobId])
  @@index([jobBidderId])
  @@index([customerId])
  @@index([contactId])
  @@index([priceListId])
  @@index([originalQuoteId])
  @@index([masterQuoteId])
  @@index([status])
  @@index([quoteDate])
  @@index([createdById])
  // The quotes list default-sorts by updatedAt; trigram indexes back its
  // ILIKE %term% search fields.
  @@index([updatedAt])
  @@index([quoteNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Quote_quoteNumber_trgm_idx")
  @@index([jobNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Quote_jobNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Quote_customerName_trgm_idx")
  @@index([projectName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Quote_projectName_trgm_idx")
  @@index([scopeLabel(ops: raw("gin_trgm_ops"))], type: Gin, map: "Quote_scopeLabel_trgm_idx")
}

enum PlanSheetSourceType {
  UPLOAD
  JOB_FILE
}

/// Construction plan PDF used for circular structure workbook takeoff markup.
model PlanSheet {
  id           String              @id @default(cuid())
  quoteId      String?
  jobId        String?
  sourceType   PlanSheetSourceType
  filePath     String
  originalName String
  pageNumber   Int                 @default(1)
  markupJson   Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  quote Quote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  job   Job?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([quoteId])
  @@index([jobId])
}

/// Individual line on a quote: stock product, configurable/custom structure, service, or misc item.
model QuoteLineItem {
  id                 String        @id @default(cuid())
  quoteId            String
  previousLineItemId String?
  lineNumber         Int
  lineType           QuoteLineType
  productId          String?
  jobStructureId     String?
  itemCode           String
  description    String?
  quantity       Decimal       @default(1) @db.Decimal(12, 4)
  unit           String        @default("EA")
  unitPrice      Decimal       @default(0) @db.Decimal(12, 2)
  weight         Decimal?      @db.Decimal(12, 2)
  yards          Decimal?      @db.Decimal(12, 4)
  taxable        Boolean       @default(true)
  total          Decimal       @default(0) @db.Decimal(12, 2)
  statusNote     String?
  sortOrder      Int           @default(0)
  notes          String?
  isDrainRing      Boolean        @default(false)
  ringDiameterFeet Decimal?       @db.Decimal(6, 2)
  poolHeightFeet   Decimal?       @db.Decimal(6, 2)
  drainRingStyle        DrainRingStyle @default(DRAIN)
  structureConfigJson   Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  quote                   Quote                    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  previousLineItem        QuoteLineItem?           @relation("QuoteLineLineage", fields: [previousLineItemId], references: [id], onDelete: SetNull)
  supersededBy            QuoteLineItem[]          @relation("QuoteLineLineage")
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  jobStructure            JobStructure?            @relation(fields: [jobStructureId], references: [id], onDelete: SetNull)
  deliveryTicketLineItems DeliveryTicketLineItem[]
  invoiceLineItems        InvoiceLineItem[]

  @@index([quoteId])
  @@index([previousLineItemId])
  @@index([productId])
  @@index([jobStructureId])
}

enum DeliveryTicketStatus {
  DRAFT
  SCHEDULED
  LOADING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DeliveryTicketType {
  JOB
  WALK_IN
}

enum DeliveryLineType {
  STOCK_PRODUCT
  CONFIGURABLE_STRUCTURE
  CUSTOM_STRUCTURE
  SERVICE
  MISC
}

enum DeliveryItemStatus {
  NOT_READY
  READY
  LOADING
  LOADED
  DELIVERED
  CANCELLED
}

/// Whether the company delivers the load or the customer picks it up.
enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

/// How a pickup / walk-in customer is paying for the load.
enum TicketPaymentMethod {
  PAY_NOW
  ON_ACCOUNT
}

/// Delivery ticket for scheduling and tracking job deliveries.
/// Ticket numbers follow DT##### format (e.g. DT10001); global sequence starting at 10001.
model DeliveryTicket {
  id                     String               @id @default(cuid())
  ticketNumber           String               @unique
  year                   Int
  yearTwoDigit           Int
  sequenceNumber         Int
  ticketType             DeliveryTicketType   @default(JOB)
  fulfillmentMethod      FulfillmentMethod    @default(DELIVERY)
  status                 DeliveryTicketStatus @default(DRAFT)
  jobId                  String?
  quoteId                String?
  customerId             String?
  priceListId            String?
  jobNumber              String?
  quoteNumber            String?
  customerName           String
  projectName            String
  deliveryAddress        String?
  siteContactName        String?
  siteContactPhone       String?
  siteContactEmail       String?
  siteInstructions       String?
  deliveryDate           DateTime?
  deliveryTime           String?
  requestedBy            String?
  createdBy              String?
  truck                  String?
  trailer                String?
  driver                 String?
  loadSequence           String?
  specialEquipmentNeeded String?
  craneRequired          Boolean              @default(false)
  forkliftRequired       Boolean              @default(false)
  totalItems             Int?
  totalWeight            Decimal?             @db.Decimal(12, 2)
  paymentMethod          TicketPaymentMethod?
  paymentReceived        Boolean              @default(false)
  pickedUpBy             String?
  driverNotes            String?
  internalNotes          String?
  customerNotes          String?
  loadingNotes           String?
  deliveredAt            DateTime?
  signedBy               String?
  paperTicketPrinted     Boolean              @default(false)
  paperTicketVerified    Boolean              @default(false)
  verifiedAt             DateTime?
  verifiedBy             String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  job       Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote     Quote?      @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer  Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  priceList PriceList?  @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  invoice   Invoice?
  lineItems DeliveryTicketLineItem[]

  @@unique([year, sequenceNumber])
  @@index([jobId])
  @@index([quoteId])
  @@index([customerId])
  @@index([priceListId])
  @@index([status])
  @@index([deliveryDate])
  @@index([yearTwoDigit])
  @@index([ticketType])
  @@index([fulfillmentMethod])
  // Trigram indexes back the tickets list's ILIKE %term% search fields.
  @@index([ticketNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_ticketNumber_trgm_idx")
  @@index([jobNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_jobNumber_trgm_idx")
  @@index([customerName(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_customerName_trgm_idx")
  @@index([projectName(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_projectName_trgm_idx")
  @@index([truck(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_truck_trgm_idx")
  @@index([driver(ops: raw("gin_trgm_ops"))], type: Gin, map: "DeliveryTicket_driver_trgm_idx")
}

/// Individual line on a delivery ticket: stock product, structure, service, or misc item.
model DeliveryTicketLineItem {
  id               String             @id @default(cuid())
  deliveryTicketId String
  lineNumber       Int
  lineType         DeliveryLineType
  productId        String?
  quoteLineItemId  String?
  jobStructureId   String?
  jobStructurePieceId String?
  itemCode         String
  description      String?
  quantity         Decimal            @default(1) @db.Decimal(12, 4)
  unit             String             @default("EA")
  weightEach       Decimal?           @db.Decimal(12, 2)
  totalWeight      Decimal?           @db.Decimal(12, 2)
  yardLocation     String?
  status           DeliveryItemStatus @default(NOT_READY)
  notes            String?
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  deliveryTicket  DeliveryTicket  @relation(fields: [deliveryTicketId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  quoteLineItem   QuoteLineItem?  @relation(fields: [quoteLineItemId], references: [id], onDelete: SetNull)
  jobStructure    JobStructure?   @relation(fields: [jobStructureId], references: [id], onDelete: SetNull)
  jobStructurePiece JobStructurePiece? @relation(fields: [jobStructurePieceId], references: [id], onDelete: SetNull)
  invoiceLineItems InvoiceLineItem[]

  @@index([deliveryTicketId])
  @@index([productId])
  @@index([quoteLineItemId])
  @@index([jobStructureId])
  @@index([jobStructurePieceId])
}

/// Global sequence counter for delivery ticket numbers (year=0 row; DT10001+).
model DeliveryTicketSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum ReceivingCategory {
  RCP
  ADS_PIPE
  DOMESTIC_CASTINGS
  IMPORTED_CASTINGS
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryTransactionType {
  PRODUCTION
  DELIVERY
  ADJUSTMENT
  REVERSAL
  PURCHASE_RECEIPT
}

enum InventoryReferenceType {
  DAILY_PRODUCTION_LINE
  DELIVERY_TICKET_LINE_ITEM
  PURCHASE_RECEIPT_LINE
}

/// Append-only ledger for stock inventory changes.
model InventoryTransaction {
  id              String                   @id @default(cuid())
  productId       String
  quantityChange  Decimal                  @db.Decimal(12, 4)
  transactionType InventoryTransactionType
  transactionDate DateTime
  referenceType   InventoryReferenceType?
  referenceId     String?
  notes           String?
  createdBy       String?
  /// Client-generated idempotency key: a resubmitted form reuses the same key,
  /// so the unique constraint turns a double-post into a no-op.
  submissionKey   String?                  @unique
  createdAt       DateTime                 @default(now())

  // Restrict: the ledger is the permanent inventory/financial history — a
  // product delete must never silently erase it.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([transactionDate])
  @@index([productId, transactionDate])
  @@index([referenceType, referenceId])
}

/// Daily batch entry for stock production (yard output).
model DailyProductionEntry {
  id             String   @id @default(cuid())
  productionDate DateTime @db.Date
  batchLabel     String?
  enteredBy      String?
  notes          String?
  /// Client-generated idempotency key (see InventoryTransaction.submissionKey).
  submissionKey  String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines DailyProductionLine[]

  @@index([productionDate])
}

/// One product/qty row on a daily production entry.
model DailyProductionLine {
  id               String  @id @default(cuid())
  productionEntryId String
  productId        String
  quantityProduced Decimal @db.Decimal(12, 4)

  productionEntry DailyProductionEntry @relation(fields: [productionEntryId], references: [id], onDelete: Cascade)
  // Restrict: production history must survive product deletion (see
  // InventoryTransaction.product).
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productionEntryId])
  @@index([productId])
}

/// Batch entry for purchased casting inventory received from a supplier.
model PurchaseReceiptEntry {
  id           String             @id @default(cuid())
  receiptDate  DateTime           @db.Date
  category     ReceivingCategory?
  supplierId   String?
  purchaseOrderId String?
  batchLabel   String?
  enteredBy    String?
  notes        String?
  /// Client-generated idempotency key (see InventoryTransaction.submissionKey).
  submissionKey String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier      CastingSupplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         PurchaseReceiptLine[]

  @@index([receiptDate])
  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([category, receiptDate])
}

/// One product/qty row on a purchase receipt entry.
model PurchaseReceiptLine {
  id                String  @id @default(cuid())
  purchaseReceiptId String
  productId         String
  quantityReceived  Decimal @db.Decimal(12, 4)

  purchaseReceipt PurchaseReceiptEntry @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  // Restrict: receiving history must survive product deletion (see
  // InventoryTransaction.product).
  product         Product              @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseReceiptId])
  @@index([productId])
}

/// AP vendor for purchase orders (pipe, castings, one-off suppliers).
model Vendor {
  id              String             @id @default(cuid())
  name            String             @unique
  status          VendorStatus       @default(ACTIVE)
  defaultCategory ReceivingCategory?
  notes           String?
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([sortOrder])
}

/// Global sequence counter for purchase order numbers (year=0 row; PO10001+).
model PurchaseOrderSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Vendor purchase order for accounts payable and receiving fulfillment.
model PurchaseOrder {
  id              String               @id @default(cuid())
  poNumber        String               @unique
  sequenceNumber  Int
  vendorId        String
  status          PurchaseOrderStatus  @default(DRAFT)
  category        ReceivingCategory?
  orderDate       DateTime             @db.Date
  expectedDate    DateTime?            @db.Date
  vendorQuotePath String?
  vendorQuoteName String?
  subtotal        Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @default(0) @db.Decimal(12, 2)
  notes           String?
  enteredBy       String?
  submissionKey   String?              @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  vendor   Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines    PurchaseOrderLine[]
  receipts PurchaseReceiptEntry[]

  @@index([vendorId])
  @@index([status])
  @@index([category])
  @@index([orderDate])
}

/// One line on a purchase order.
model PurchaseOrderLine {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  lineNumber       Int
  productId        String?
  itemCode         String
  description      String?
  quantityOrdered  Decimal @db.Decimal(12, 4)
  quantityReceived Decimal @default(0) @db.Decimal(12, 4)
  unit             String  @default("EA")
  unitPrice        Decimal @default(0) @db.Decimal(12, 4)
  total            Decimal @default(0) @db.Decimal(12, 2)
  sortOrder        Int     @default(0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@index([productId])
}

/// Daily confirmation that printed paper tickets match digital records.
model DeliveryDayReconciliation {
  id                 String   @id @default(cuid())
  reconciliationDate DateTime @unique @db.Date
  confirmedBy        String?
  confirmedAt        DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum InvoiceLineType {
  STOCK_PRODUCT
  CONFIGURABLE_STRUCTURE
  CUSTOM_STRUCTURE
  SERVICE
  MISC
}

/// Customer invoice — one per delivered delivery ticket.
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  year            Int
  yearTwoDigit    Int
  sequenceNumber  Int
  deliveryTicketId String       @unique
  jobId           String?
  quoteId         String?
  customerId      String?
  jobNumber       String?
  customerName    String
  projectName     String
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  deliveryAmount  Decimal       @default(0) @db.Decimal(12, 2)
  taxableAmount   Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @default(0) @db.Decimal(6, 4)
  salesTax        Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  invoiceDate     DateTime?
  dueDate         DateTime?
  finalizedAt     DateTime?
  finalizedBy     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deliveryTicket DeliveryTicket @relation(fields: [deliveryTicketId], references: [id], onDelete: Restrict)
  job            Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  quote          Quote?         @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lineItems      InvoiceLineItem[]

  @@unique([year, sequenceNumber])
  @@index([jobId])
  @@index([quoteId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceLineItem {
  id                       String          @id @default(cuid())
  invoiceId                String
  lineNumber               Int
  lineType                 InvoiceLineType
  quoteLineItemId          String?
  deliveryTicketLineItemId String?
  productId                String?
  itemCode                 String
  description              String?
  quantity                 Decimal         @default(1) @db.Decimal(12, 4)
  unit                     String          @default("EA")
  unitPrice                Decimal         @default(0) @db.Decimal(12, 2)
  taxable                  Boolean         @default(true)
  total                    Decimal         @default(0) @db.Decimal(12, 2)
  sortOrder                Int             @default(0)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  invoice                Invoice                 @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  quoteLineItem          QuoteLineItem?          @relation(fields: [quoteLineItemId], references: [id], onDelete: SetNull)
  deliveryTicketLineItem DeliveryTicketLineItem? @relation(fields: [deliveryTicketLineItemId], references: [id], onDelete: SetNull)
  product                Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([quoteLineItemId])
  @@index([deliveryTicketLineItemId])
  @@index([productId])
}

/// Per-year sequence counter for invoice numbers.
model InvoiceSequence {
  id         String   @id @default(cuid())
  year       Int      @unique
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Product pricing list for quotes and walk-in delivery tickets.
model PriceList {
  id            String    @id @default(cuid())
  name          String    @unique
  effectiveDate DateTime?
  isDefault     Boolean   @default(false)
  fobDefault    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items           PriceListItem[]
  quotes          Quote[]
  deliveryTickets DeliveryTicket[]
}

model PriceListItem {
  id          String   @id @default(cuid())
  priceListId String
  productId   String
  unitPrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@index([priceListId])
  @@index([productId])
}

/// Delivery pricing zone: either a radius ring measured from the yard, or a
/// hand-drawn polygon (used inside NYC where radius bands don't fit).
model ShippingZone {
  id          String           @id @default(cuid())
  name        String
  kind        ShippingZoneKind
  /// RADIUS zones: outer edge in straight-line miles from the yard.
  radiusMiles Decimal?         @db.Decimal(8, 2)
  /// POLYGON zones: array of [lat, lng] vertex pairs (unclosed ring).
  polygon     Json?
  ratePerLoad Decimal          @db.Decimal(12, 2)
  color       String           @default("#2563eb")
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([active])
}

enum ShippingZoneKind {
  RADIUS
  POLYGON
}

/// Singleton application configuration (id is always "default").
model AppSettings {
  id        String   @id @default("default")
  // company
  companyName     String
  companyAddress  String
  companyPhone    String
  companyEmail    String
  appTitle        String
  appSubtitle     String
  quoteFooterText String?
  /// Send-quote email templates; null = built-in default. Placeholders:
  /// {contact} {customer} {project} {quoteNumber} {companyName}
  /// {companyPhone} {companyEmail}
  quoteEmailSubjectTemplate String?
  quoteEmailBodyTemplate    String?
  /// Message styling for quote emails; null = Arial / 14 / near-black.
  quoteEmailFontFamily String?
  quoteEmailFontSizePx Int?
  quoteEmailTextColor  String?
  /// Branded signature block appended to quote emails (blue serif look).
  /// Blank name = no signature block.
  quoteEmailSignatureName      String?
  quoteEmailSignatureCompany   String?
  quoteEmailSignatureAddress   String?
  quoteEmailSignaturePhoneLine String?
  quoteEmailSignatureEmail     String?
  quoteEmailSignatureColor     String?
  deliveryTicketCopy1Title   String?
  deliveryTicketCopy2Title   String?
  deliveryTicketCopy3Title   String?
  deliveryTicketFooterText   String?
  /// Silent ticket printing from the server host; null = browser print dialog.
  ticketPrinterName          String?
  /// "color" | "monochrome"; null = color.
  ticketPrintColorMode       String?
  /// Silent submittal-package printing; null = browser print dialog.
  submittalPrinterName       String?
  /// "color" | "monochrome"; null = color.
  submittalPrintColorMode    String?
  companyLogoPath   String?
  // paths
  jobsRoot            String
  quotePdfFallbackDir String
  stockSubmittalsRoot String
  jobSubfolders       Json
  // billing
  defaultTaxRate    Decimal @db.Decimal(6, 3)
  quoteValidityDays Int
  invoiceDueDays    Int
  ticketNumberPrefix  String @default("T")
  invoiceNumberPrefix String @default("I")
  ticketNumberStart   Int    @default(10001)
  defaultLeadTime   String?
  paymentTerms      Json
  // operations
  estimators         Json
  trucks             Json
  drivers            Json
  trailers           Json
  truckCapacityLabel String
  // shipping zones: yard anchor point for radius-based zones
  yardLatitude  Decimal? @db.Decimal(9, 6)
  yardLongitude Decimal? @db.Decimal(9, 6)
  ringBuilderConfig  Json     @default("[]")
  rolePermissions    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  ESTIMATOR
  DISPATCHER
  PRODUCTION
  OFFICE
  READ_ONLY
}

enum AppPermission {
  CUSTOMERS_VIEW
  CUSTOMERS_MANAGE
  PRODUCTS_VIEW
  PRODUCTS_MANAGE
  STRUCTURES_VIEW
  STRUCTURES_MANAGE
  JOBS_VIEW
  JOBS_MANAGE
  QUOTES_VIEW
  QUOTES_MANAGE
  PRODUCTION_VIEW
  PRODUCTION_MANAGE
  INVOICES_VIEW
  INVOICES_MANAGE
  DELIVERY_VIEW
  DELIVERY_MANAGE
  INVENTORY_VIEW
  INVENTORY_MANAGE
  FILES_VIEW
  FILES_MANAGE
  SETTINGS_VIEW
  SETTINGS_MANAGE
  USERS_MANAGE
}

model User {
  id                 String          @id @default(cuid())
  username           String          @unique
  displayName        String
  initials           String
  email              String?
  role               UserRole        @default(OFFICE)
  grantedPermissions AppPermission[] @default([])
  deniedPermissions  AppPermission[] @default([])
  passwordHash       String?
  mustChangePassword Boolean         @default(false)
  isActive           Boolean         @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  jobFavorites  JobFavorite[]
  quotesCreated Quote[]         @relation("QuoteCreatedBy")
}

model JobFavorite {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
